# 所有 AI 功能共用一套 LLM 配置；默认 DeepSeek，只需替换一次密钥。
# auto：有效密钥自动启用模型，无密钥离线；offline：全局禁用；model：强制模型。
LLM_MODE=auto
LLM_API_KEY=your-api-key
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# 服务商适配默认按地址判断；其他兼容服务修改地址和模型即可。
# LLM_PROVIDER=compatible
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_TIMEOUT=35
LLM_CONNECT_TIMEOUT=10
LLM_MAX_CONNECTIONS=4

# 数据库
DATABASE_URL=postgresql+asyncpg://bankuser:bankpass@localhost:5432/banking_agent

# 安全
JWT_SECRET=your-jwt-secret-change-in-production
INTERNAL_BANK_TOKEN=replace-with-a-separate-internal-secret
BANK_BUSINESS_TIMEZONE=Asia/Shanghai
# 5号仅通过此地址调用4号模拟银行 API；Docker 单容器默认值无需修改
BANK_API_BASE_URL=http://127.0.0.1:8000
# 短信验证码：与验证器 TOTP 并列的第二因素（红色强验证二选一）。false 时仅保留 TOTP。
MFA_SMS_ENABLED=true
# mock：模拟通道，不真实发送；真实通道需实现 backend/app/security/sms.py 的 SmsProvider。
SMS_PROVIDER=mock
# 仅 mock 通道生效：GET /api/v1/auth/sms/dev-inbox 查看本人模拟短信，部署时请设为 false。
SMS_DEV_INBOX_ENABLED=true
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_MAX_SENDS_PER_HOUR=10
# 验证码哈希密钥；未设置时回退 JWT_SECRET。
# SMS_CODE_HASH_KEY=
DAILY_TRANSFER_LIMIT=50000

# 服务端口
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 理财与转账、卡片复用TOTP/短信验证；旧WEALTH_DEMO_VERIFICATION_ENABLED不再生效。

# 理财行情同步与模型配置独立，默认不启用日更。
WEALTH_MARKET_SYNC_ENABLED=false
# Full-directory details fetch public evidence in a bounded background task.
# Install requirements-market.txt before enabling; real funds remain research-only.
WEALTH_FUND_ON_DEMAND_ENABLED=false
# 当前可处置模拟轮次的重置/资金调整/归档删除；普通账户仍永远禁止。
WEALTH_DEMO_TOOLS_ENABLED=false
# 服务端可信操作员主体白名单，逗号分隔；默认无人有操作员权限。
WEALTH_OPERATOR_USER_IDS=
